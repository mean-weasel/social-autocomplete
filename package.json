{
  "name": "social-metadata-research",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first social metadata research contracts and CLI",
  "type": "module",
  "bin": {
    "social-metadata": "./bin/social-metadata.js"
  },
  "files": [
    ".codex-plugin",
    ".claude-plugin",
    ".agents/plugins",
    "assets",
    "bin",
    "dist/src",
    "schemas",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cli-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:core": "npm run build --silent && node --test dist/tests/core/*.test.js",
    "test:modules": "npm run build --silent && node --test dist/tests/modules/*.test.js",
    "lint:playbooks": "npm run build --silent && node dist/tests/channels/lint-playbooks.js",
    "test:channels": "npm run build --silent && node --test dist/tests/channels/*.test.js",
    "test:fixture-replay": "npm run build --silent && node dist/tests/channels/fixture-replay-router.js",
    "test:hosts": "npm run build --silent && node --test dist/tests/hosts/*.test.js",
    "test:host-parity": "npm run build --silent && node dist/tests/hosts/host-parity.js",
    "test:install": "npm run build --silent && node --test tests/install-smoke.test.mjs && node scripts/install-smoke/run.mjs",
    "test:integration": "npm run build --silent && node --test dist/tests/integration/*.test.js",
    "verify:offline": "npm run typecheck && npm run test:core && npm run test:modules && npm run lint:playbooks && npm run test:channels && npm run test:fixture-replay -- --scope modules && npm run test:fixture-replay -- --scope channels && npm run test:hosts && npm run test:host-parity && npm run test:integration && npm run test:qa-campaign && npm run test:qa-config && npm run test:qa-single-task && npm run test:qa-recovery",
    "example:subprocess": "npm run build --silent && node examples/subprocess-consumer/run.mjs",
    "test:subprocess-consumer": "npm run build --silent && node --test tests/browser-acceptance/subprocess-consumer-ownership.test.mjs",
    "test:diagnostics": "npm run build --silent && node --test dist/tests/browser-acceptance/diagnostics.test.js",
    "test:browser-harness": "npm run build --silent && node --test dist/tests/browser-acceptance/harness.test.js tests/browser-acceptance/coverage.test.mjs",
    "test:qa-config": "node --test tests/browser-acceptance/qa-config.test.mjs tests/browser-acceptance/qa-manager-prompt.test.mjs",
    "test:qa-single-task": "node --test tests/browser-acceptance/qa-single-task.test.mjs",
    "test:qa-campaign": "node --test tests/browser-acceptance/qa-campaign.test.mjs",
    "test:qa-recovery": "node --test tests/browser-acceptance/qa-recovery.test.mjs",
    "test:ci-contract": "node --test tests/ci/ci-contract.test.mjs",
    "test:package": "npm run build --silent && node scripts/ci/package-smoke.mjs",
    "validate:repo": "node scripts/ci/validate-repository.mjs",
    "verify:ci": "npm run validate:repo && npm run verify:offline && npm run test:diagnostics && npm run test:browser-harness && npm run test:subprocess-consumer && npm run test:ci-contract && npm run test:package",
    "qa:scenario:validate": "node scripts/browser-acceptance/validate-qa-config.mjs",
    "verify:release": "node scripts/browser-acceptance/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "ajv": "^8.17.1",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  }
}
