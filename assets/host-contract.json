{
  "contractVersion": "1.0",
  "shared": {
    "discovery": ["natural_language", "direct_skill_invocation"],
    "modes": {
      "guided": {
        "initialConfirmation": true,
        "queryApprovalStagesPerChannel": 2
      },
      "automatic": {
        "initialConfirmation": true,
        "queryApprovalStagesPerChannel": 0
      }
    },
    "interruptions": ["authentication_required", "challenge", "ui_change", "locale_mismatch"],
    "incrementalResult": "after_each_channel",
    "browserOwner": "plugin",
    "cliOwner": "contracts_state_validation",
    "browserSession": {
      "selectionRequiredBeforePlan": true,
      "codexChoices": ["chrome", "in_app"],
      "recordedInPlan": true,
      "adjustment": "append_only_user_confirmed_amendment",
      "silentSwitch": "prohibited",
      "authenticated": "existing_user_controlled_chrome_profile",
      "public": "host_managed_visible_browser_only",
      "standalonePlaywrightChromium": "unsupported",
      "profilePersistence": "prohibited",
      "signIn": "user_manual_same_session_pause_and_resume",
      "credentialHandling": "never_request_read_type_transmit_or_store"
    },
    "dedicatedTarget": {
      "ownership": "plugin_owned",
      "scope": "task_channel",
      "acquisition": "new_agent_tab_from_retained_task_browser_binding",
      "navigation": "typed_official_root_only",
      "userTabs": "never_list_claim_inspect_or_reuse",
      "rawHandle": "host_runtime_only",
      "sanitizedIdentity": "deterministic_sha256_lease_hash",
      "sameTaskAuthentication": "retain_live_handle",
      "taskBoundary": "discard_and_recreate_from_official_root",
      "normalCompletion": "release_required",
      "authenticationHandoff": "sole_release_exception"
    },
    "channelSelection": {
      "selectionRequiredBeforePlan": true,
      "explicitPrompt": "Which channels should I research, and in what order?",
      "supported": ["facebook", "instagram", "linkedin", "x", "tiktok", "youtube", "pinterest"],
      "ordered": true,
      "recordedInPlan": true,
      "newRunInheritance": "prohibited",
      "resume": "reuse_same_run_without_reprompt"
    },
    "authenticatedInspection": {
      "targetFiltering": "plugin_created_target_expected_origin_validation_before_projection",
      "completeOpenTabLists": "prohibited",
      "fullDomSnapshots": "prohibited",
      "bodyText": "prohibited",
      "feedContent": "prohibited",
      "accountIdentifiers": "prohibited",
      "broadenReadAfterFailure": "prohibited",
      "projection": {
        "structuralBooleans": [
          "targetMatched",
          "authenticationRequired",
          "challengePresent",
          "localeMatches",
          "searchLandmarkPresent",
          "resultsLandmarkPresent"
        ],
        "sanitizedStatus": true,
        "routeClass": true,
        "expectedLandmark": true,
        "observedLandmark": true
      }
    },
    "codexCatalog": {
      "model": "single_orchestrator_with_linked_channel_resources",
      "topLevelSkills": ["social-metadata-research"],
      "channelResources": ["facebook", "instagram", "linkedin", "x", "tiktok", "youtube", "pinterest"],
      "directChannelInvocation": "not_required"
    },
    "prohibited": ["publishing", "composer_interaction", "scraping", "authentication_bypass"]
  },
  "hosts": {
    "codex": {
      "authenticatedBrowser": "chrome",
      "publicBrowser": "in_app",
      "directInvocation": "$social-metadata-research:social-metadata-research"
    },
    "claude": {
      "authenticatedBrowser": "chrome",
      "publicBrowser": null,
      "directInvocation": "/social-metadata-research:social-metadata-research"
    }
  }
}
